<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projekt Planung</title>
    <link rel="stylesheet" href="/css/private/planning.css">
</head>
<body>
    <%- include('../partials/overlay') %>

    <div class="project-planning-box">
        <h1 class="project-planning-title"><%= project.title %></h1>
        <p class="project-planning-description"><%= project.description || 'Keine Beschreibung vorhanden.' %></p>
        <div class="project-planning-stats">
            <p class="project-planning-processes"><%= tasks.length %> Vorgänge</p>
            <p class="project-planning-creation-date"><%= new Date(project.created_at).toLocaleDateString('de-DE') %></p>
        </div>
    </div>

    <div class="project-planning-processes" data-project-id="<%= projectId %>">
        <div class="project-planning-process-titles">
            <p>Nr.</p>
            <p>Vorgangsname</p>
            <p>Tage</p>
            <p>Vorgänger</p>
            <p aria-label="Aktionen"></p>
        </div>
        <% tasks.forEach(task => { %>
            <div class="project-planning-process" draggable="true">
                <p class="project-planning-process-number"><%= task.id %></p>
                <input class="project-planning-process-name" type="text" value="<%= task.title %>" aria-label="Name des Vorgangs <%= task.id %>" draggable="false">
                <input class="project-planning-process-days" type="number" min="0" step="1" value="<%= task.days %>" aria-label="Tage für <%= task.title %>" draggable="false">
                <div class="project-planning-predecessor-select">
                    <button type="button" class="project-planning-process-predecessor" aria-haspopup="listbox" aria-expanded="false" draggable="false">
                        <%= task.predecessor || 'Keine Vorgänger vorhanden.' %>
                    </button>
                    <div class="project-planning-predecessor-options" role="listbox"></div>
                </div>
                <button type="button" class="project-planning-process-delete" aria-label="Vorgang <%= task.id %> löschen" draggable="false">
                    <img src="/icons/trash.svg" alt="">
                </button>
            </div>
        <% }) %>
        <button type="button" class="project-planning-process-create">
            <img src="/icons/plus.svg" alt="Create Process">
            <p class="project-planning-process-create-button">Vorgang hinzufügen</p>
        </button>
    </div>
    <script src="/js/planning/drag.js"></script>
    <script src="/js/planning/select_predecessor.js"></script>
    <script src="/js/planning/create_process.js"></script>
    <script src="/js/planning/delete_process.js"></script>
    <script src="/js/planning/planning.js"></script>
</body>