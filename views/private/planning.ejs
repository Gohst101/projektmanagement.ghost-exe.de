<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Planing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/private/planning.css">
</head>
<body>
    <%- include('../partials/overlay') %>

    <div class="project-planning-box">
        <h1 class="project-planning-title"><%= project.title %></h1>
        <p class="project-planning-description"><%= project.description || 'Keine Beschreibung vorhanden.' %></p>
        <div class="project-planning-stats">
            <p class="project-planning-processes"><%= tasks.length %> Vorgänge</p>
            <p class="project-planning-creation-date"><%= new Date(project.created_at).toLocaleDateString('de-DE') %></p>
        </div>
    </div>

    <div class="project-planning-processes">
        <div class="project-planning-process-titles">
            <p>Nr.</p>
            <p>Vorgangsname</p>
            <p>Tage</p>
            <p>Vorgänger</p>
        </div>
        <% tasks.forEach(task => { %>
            <div class="project-planning-process" draggable="true">
                <p class="project-planning-process-number"><%= task.id %></p>
                <input class="project-planning-process-name" type="text" name="task-title-<%= task.id %>" value="<%= task.title %>" aria-label="Vorgangsname">
                <input class="project-planning-process-days" type="number" name="task-days-<%= task.id %>" value="<%= task.days %>" min="0" aria-label="Tage">
                <div class="project-planning-predecessor-select">
                    <input class="project-planning-process-predecessor" type="text" name="task-predecessor-<%= task.id %>" value="<%= task.predecessor || '' %>" placeholder="Keine Vorgänger" aria-label="Vorgänger" readonly>
                    <div class="project-planning-predecessor-options" role="listbox" aria-label="Vorgänger auswählen">
                        <% tasks.forEach(predecessorTask => { %>
                            <% if (predecessorTask.id !== task.id) { %>
                                <button type="button" class="project-planning-predecessor-option" data-task-id="<%= predecessorTask.id %>" role="option">
                                    <%= predecessorTask.id %> - <%= predecessorTask.title %>
                                </button>
                            <% } %>
                        <% }) %>
                    </div>
                </div>
            </div>
        <% }) %>
        <button type="button" class="project-planning-process-create">
            <img src="/icons/plus.svg" alt="Create Process">
            <p class="project-planning-process-create-button">Vorgang hinzufügen</p>
        </button>
    </div>
    <script src="/js/planning/planning.js"></script>
</body>