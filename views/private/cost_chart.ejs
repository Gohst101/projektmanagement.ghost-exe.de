<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Planing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/private/cost_chart.css">
    <script src="https://jsdelivr.net"></script> <!--can be removed later when the js is no longer included in html-->
</head>
<body>
    <%- include('../partials/overlay') %>    

    <div class="cost_chart_workers">
        <canvas id="cost_chart_workers"></canvas>
    </div>
    <div class="cost_chart">
        <canvas id="cost_chart"></canvas>
    </div>

    <!-- script to load the cost chart data from the database and create the charts -->
    <script> // script should be moved to a separate js file later
    async function LodingDiagramms() {
        try {
        // calling Data from the database for the cost chart
        const response = await fetch('/api/cost_chart_data'); // Replace with your actual API endpoint
        const dbDaten = await response.json();
        
        // Preparing time axis labels and data for the cost chart
        const zeitachseLabels = dbDaten.map((row, index) => `Block ${index + 1} (P=${row.person_anzahl})`);
        const zeitachseData = dbDaten.map(row => [row.start_tag, row.end_tag]); // Floating Bars [Start, Ende]

        // creating the cost chart for workers amount
        const ctxWorkers = document.getElementById('cost_chart_workers').getContext('2d');
        const costChartWorkers = new Chart(ctxWorkers, {
            type: 'bar',
            data: {
                labels: zeitachseLabels, // Labels for the x-axis
                datasets: [{
                    label: 'Arbeitszeitraum (Start- und Endtag)',
                    data: zeitachseData, // Data for the y-axis
                    backgroundColor: '#19212C',
                    borderColor: '#FFFFFF',
                    borderWidth: 1
                }]
            },
            options: {
                indexAxis: 'y', // Make it a horizontal bar chart
                responsive: true,
                scales: { x: { min: 0, ticks: { color: '#fff' },title: { display: true, text: 'Tage' } }, y: { ticks: { color: '#fff' },title: { display: true, text: 'Kosten in €' } } }
            }
        });

        // Preparing spending data for the cost chart
        const kostenData = dbDaten.map(row => {
            const tage = row.end_tag - row.start_tag;
            return tage * row.person_anzahl * row.lohn_pro_tag; // Beispielrechnung für die Säulenhöhe
            });

        // creating the main cost chart    
        const ctxCosts = document.getElementById('cost_chart').getContext('2d');
        const costChart = new Chart(ctxCosts, {
            type: 'bar',
            data: {
                labels: dbDaten.map(row => `Tag ${row.start_tag}-${row.end_tag}`), // Labels for the x-axis
                datasets: [{
                    label: 'Löhne',
                    data: kostenData, // Data for the y-axis
                    backgroundColor: '#19212C',
                    borderColor: '#FFFFFF',
                    borderWidth: 1
                }]
            },
            options: {
            responsive: true,
            scales: { x: { ticks: { color: '#fff' },title: { display: true, text: 'Tage' } }, y: { beginAtZero: true, ticks: { color: '#fff' },title: { display: true, text: 'Kosten in €' } } }
          }
        });
      } catch (error) {
        console.error('Fehler beim Laden der Chart-Daten:', error);
      }
    }  
        LodingDiagramms();
    </script>
</body>