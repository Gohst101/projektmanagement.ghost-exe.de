<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Netzplan – <%= project.title %></title>
    <link rel="stylesheet" href="/css/private/network_plan.css">
</head>
<body>
    <%- include('../partials/overlay') %>

    <main class="network-plan-page" data-network-plan data-project-tasks="<%= JSON.stringify(project.tasks) %>">
        <h1><%= project.title %> – Netzplan</h1>
        <p class="network-plan-status" data-chart-status role="status" aria-live="polite"></p>
        <div class="network-plan-map" data-network-canvas>
            <svg class="network-plan-edges" aria-hidden="true"></svg>
            <div class="network-plan-nodes"></div>
        </div>
        <div class="network-plan-legend">
            <span><i class="legend-process"></i>Vorgang</span>
            <span><i class="legend-critical"></i>Kritischer Pfad</span>
            <span>FAZ / FEZ: frühester Anfang / frühestes Ende</span>
            <span>SAZ / SEZ: spätester Anfang / spätestes Ende</span>
            <span>Puffer: mögliche Verzögerung in Tagen</span>
        </div>
    </main>
    <script src="/js/project_chart_data.js" defer></script>
    <script src="/js/network_plan.js" defer></script>
</body>
</html>
