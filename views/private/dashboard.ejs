                <p class="project-processes">7 Vorgänge</p>
                <p class="project-creation-date">16.09.2026</p>
            </div>
        </div>
        <div class="project-box">
            <h1 class="project-title">BFI LF6 Projekt 1</h1>
            <p class="project-description">Zarbombe.</p>
            <div class="project-stats">
                <p class="project-processes">12 Vorgänge</p>
