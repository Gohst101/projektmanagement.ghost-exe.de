<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projekt Diagramm</title>
    <link rel="stylesheet" href="/css/private/bar_chart.css">
</head>
<body>
    <%- include('../partials/overlay') %>

    <div class="bar-chart">
        <table>
            <thead>
                <tr>
                    <th>Nr.</th>
                    <th>Vorgangsname</th>
                    <th>Dauer</th>
                    <th>Vorgänger</th>
                    <th>1</th>
                    <th>2</th>
                    <th>3</th>
                    <th>4</th>
                    <th>5</th>
                    <!-- Duration will be generated automaticly later -->
                </tr>
            </thead>
            <tbody class="bar-chart-processes"> <!-- Table rows will be generated automaticly later => Needs a way to display one box with full background color to visualise the days -->
                <tr class="bar-chart-process">
                    <td class="bar-chart-process-number">1</td>
                    <td class="bar-chart-process-title">Planen des Autos</td>
                    <td class="bar-chart-process-duration">3</td>
                    <td class="bar-chart-process-predecessor">/</td>
                    <td class="bar-chart-process-duration-feld"></td>
                    <td class="bar-chart-process-duration-feld"></td>
                    <td class="bar-chart-process-duration-feld"></td>
                    <td class="bar-chart-process-duration-feld"></td>
                    <td class="bar-chart-process-duration-feld"></td>
                    <td class="bar-chart-process-duration-feld"></td>
                    <td class="bar-chart-process-duration-feld"></td>
                </tr>
                <tr class="bar-chart-process">
                    <td class="bar-chart-process-number">2</td>
                    <td class="bar-chart-process-title">Materiealien besorgen</td>
                    <td class="bar-chart-process-duration">2</td>
                    <td class="bar-chart-process-predecessor">1</td>
                    <td class="bar-chart-process-duration-feld"></td>
                    <td class="bar-chart-process-duration-feld"></td>
                    <td class="bar-chart-process-duration-feld"></td>
                    <td class="bar-chart-process-duration-feld"></td>
                    <td class="bar-chart-process-duration-feld"></td>
                    <td class="bar-chart-process-duration-feld"></td>
                    <td class="bar-chart-process-duration-feld"></td>
                </tr>
            </tbody>
        </table>
    </div>
</body>