<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Balkendiagramm – <%= project.title %></title>
    <link rel="stylesheet" href="/css/private/bar_chart.css">
</head>
<body>
    <%- include('../partials/overlay') %>

    <main class="bar-chart-page">
        <h1><%= project.title %> – Zeitplan</h1>
        <p class="chart-status" data-chart-status role="status" aria-live="polite"></p>
        <div class="bar-chart" data-bar-chart data-project-tasks="<%= JSON.stringify(project.tasks) %>">
            <table>
                <caption>Vorgänge nach frühestem Starttag und Dauer</caption>
                <thead></thead>
                <tbody class="bar-chart-processes"></tbody>
            </table>
        </div>
    </main>
    <script src="/js/project_chart_data.js" defer></script>
    <script src="/js/bar_chart.js" defer></script>
</body>
</html>
