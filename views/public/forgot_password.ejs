<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Passwort vergessen</title>
    <link rel="stylesheet" href="/css/public/login.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <main class="login-box">
        <h1>Passwort zurücksetzen</h1>
        <p>Gib deine Konto-E-Mail-Adresse ein. Wenn ein Konto existiert, senden wir dir einen zeitlich begrenzten Link.</p>
        <form action="/auth/password-reset/request" method="POST" data-reset-request>
            <div class="inputbox-email">
                <label for="email">E-Mail</label>
                <input type="email" id="email" name="email" autocomplete="email" required>
            </div>
            <div class="submit-section">
                <button type="submit">Link anfordern</button>
            </div>
        </form>
        <p data-request-status role="status" aria-live="polite"></p>
        <div class="error-section">
            <% if (error) { %><p role="alert"><%= error %></p><% } %>
            <% if (message) { %><p class="success-message" role="status"><%= message %></p><% } %>
        </div>
        <p><a href="/login">Zurück zur Anmeldung</a></p>
    </main>
    <script src="/js/public/forgot_password.js" defer></script>
</body>
</html>
