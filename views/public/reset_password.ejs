<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neues Passwort festlegen</title>
    <link rel="stylesheet" href="/css/public/login.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <main class="login-box">
        <h1>Neues Passwort festlegen</h1>
        <% if (error) { %>
            <p class="error-message" role="alert"><%= error %></p>
        <% } %>
        <% if (code) { %>
            <form action="/auth/password-reset" method="POST" data-password-reset>
                <input type="hidden" name="code" value="<%= code %>">
                <div class="inputbox-password">
                    <label for="password">Neues Passwort</label>
                    <input type="password" id="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" required>
                </div>
                <div class="inputbox-password">
                    <label for="password_confirm">Passwort wiederholen</label>
                    <input type="password" id="password_confirm" name="password_confirm" minlength="8" maxlength="72" autocomplete="new-password" required>
                </div>
                <p data-password-message role="alert"></p>
                <div class="submit-section">
                    <button type="submit">Passwort speichern</button>
                </div>
            </form>
        <% } else { %>
            <p><a href="/forgot-password">Neuen Link anfordern</a></p>
        <% } %>
        <p><a href="/login">Zur Anmeldung</a></p>
    </main>
    <script src="/js/public/password_reset.js" defer></script>
</body>
</html>
