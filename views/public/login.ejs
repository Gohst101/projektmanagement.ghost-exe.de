<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anmelden</title>
    <link rel="stylesheet" href="/css/public/login.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="login-box">
        <h1>Mit Konto anmelden</h1>
        <form action="/auth/login" method="POST">
            <div class="inputbox-email">
                <label for="email">E-Mail</label>
                <input type ="email" id="email" name="email" placeholder="maxmusterman@gmail.com" required>
            </div>

            <div class="inputbox-password">       
                <label for="password">Passwort</label>
                <input type="password" id="password" name="password" placeholder="********" required>
            </div>
        
            <div class="submit-section">
                <button type="submit">Anmelden</button>
            </div>
        </form>
        
        <div class="error-section">
            <% if ( error !== null ) { %>
                <p><%= error %></p>
            <% } %>
        </div>

        <p>Noch kein Konto? <a href="/register">Zum Registrieren</a></p>
    </div>
</body>
</html>
