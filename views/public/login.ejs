<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anmelden</title>
    <link rel="stylesheet" href="/css/public/login.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="login-box">
        <h1>Mit Konto anmelden</h1>
        <form action="/auth/login" method="POST">
            <div class="inputbox-email">
                <label for="email">E-Mail</label>
                <input type ="email" id="email" name="email" placeholder="maxmusterman@gmail.com" required>
            </div>

            <div class="inputbox-password">       
                <label for="password">Passwort</label>
                <input type="password" id="password" name="password" placeholder="********" autocomplete="current-password" required>
                <button type="button" data-toggle-password aria-pressed="false">Passwort anzeigen</button>
            </div>
        
            <label class="remember-me">
                <input type="checkbox" name="remember_me" value="true">
                Angemeldet bleiben (7 Tage)
            </label>
            <div class="submit-section">
                <button type="submit">Anmelden</button>
            </div>
        </form>
        
        <div class="error-section">
            <% if ( error !== null ) { %>
                <p role="alert"><%= error %></p>
            <% } %>
            <% if ( message !== null ) { %>
                <p class="success-message" role="status"><%= message %></p>
            <% } %>
        </div>

        <p>Noch kein Konto? <a href="/register">Zum Registrieren</a></p>
        <p><a href="/forgot-password">Passwort vergessen?</a></p>
    </div>
    <script src="/js/public/login.js" defer></script>
</body>
</html>
