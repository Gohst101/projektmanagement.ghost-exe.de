<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projektmanagement</title>
    <link rel="stylesheet" href="/css/public/register.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="register-box">
        <h1>Neues Konto erstellen</h1>
        <form action="/auth/register" method="POST">
            <div class="inputbox-Benutzername">
                <label for="username">Benutzername</label>
                <input type ="text" id="username" name="username" placeholder="Benutzername" required>
            </div>

            <div class="inputbox-email">
                <label for="email">E-Mail</label>
                <input type ="email" id="email" name="email" placeholder="maxmusterman@gmail.com" required>
            </div>

            <div class="inputbox-password">       
                <label for="password">Passwort</label>
                <input type="password" id="password" name="password" placeholder="********" required>
            </div>

            <div class="inputbox-password_wiederholen">       
                <label for="password_confirm">Passwort bestätigen</label>
                <input type="password" id="password_confirm" name="password_confirm" placeholder="********" required>
            </div>
        
            <div class="submit-section">
                <button type="submit">Registrieren</button>
            </div>
        </form>

        <div class="message-section">
            <% if ( error !== null ) { %>
                <p class="error"><%= error %></p>
            <% } %>

            <% if ( message !== null ) { %>
                <p class="message"><%= message %></p>
            <% } %>
        </div>

        <p>Schon registriert? <a href="/login">Zum Anmelden</a></p>
    </div>
</body>
</html>
