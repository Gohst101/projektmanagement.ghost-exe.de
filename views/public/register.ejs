<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Planing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="register.css">
</head>
<body>
   <nav class="navbar"> <%- include('../partials/navbar') %></nav>
     <div class="register-box">
        <h1>Neues Konto erstellen</h1>
            <form action="register.css" method="POST">

            <div class="inputbox-Benutzername">
                <label for="username">Benutzername</label>
                  <input type ="text" id="username" name="username" placeholder="Benutzername" required>
            </div>


            <div class="inputbox-email">
                <label for="email">E-Mail</label>
                  <input type ="email" id="email" name="email" placeholder="maxmusterman@gmail.com" required>
            </div>

           <div class="inputbox-password">       
                <label for="password">Passwort</label>
                <input type="password" id="password" name="password" placeholder="********" required>
           </div>

           <div class="inputbox-password_wiederholen">       
                <label for="password_confirm">Passwort bestätigen</label>
                <input type="password" id="password_confirm" name="password_confirm" placeholder="********" required>
           </div>
        
           <div class="submit-section">
                <button type="submit">Anmelden</button>
           </div>
            </form>

        <p>
            Schon registriert?
            <a href="login.html">Zum Login</a>
        </p>

    </div>

</body>
</html>
