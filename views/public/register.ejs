<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projektmanagement</title>
    <link rel="stylesheet" href="/css/public/register.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="register-box">
        <h1>Neues Konto erstellen</h1>
        <form action="/auth/register" method="POST" data-register-form>
            <div class="inputbox-Benutzername">
                <label for="username">Benutzername</label>
                <input type="text" id="username" name="username" placeholder="Benutzername" minlength="2" maxlength="40" autocomplete="username" required>
            </div>

            <div class="inputbox-email">
                <label for="email">E-Mail</label>
                <input type="email" id="email" name="email" placeholder="maxmusterman@gmail.com" autocomplete="email" required>
            </div>

            <div class="inputbox-password">       
                <label for="password">Passwort</label>
                <input type="password" id="password" name="password" placeholder="Mindestens 8 Zeichen" minlength="8" maxlength="72" autocomplete="new-password" required>
            </div>

            <div class="inputbox-password_wiederholen">       
                <label for="password_confirm">Passwort bestätigen</label>
                <input type="password" id="password_confirm" name="password_confirm" placeholder="Passwort wiederholen" minlength="8" maxlength="72" autocomplete="new-password" required>
            </div>
            <p class="form-validation-message" data-password-message role="alert"></p>
        
            <div class="submit-section">
                <button type="submit">Registrieren</button>
            </div>
        </form>

        <div class="message-section">
            <% if ( error !== null ) { %>
                <p class="error"><%= error %></p>
            <% } %>

            <% if ( message !== null ) { %>
                <p class="message"><%= message %></p>
            <% } %>
        </div>

        <form action="/auth/verification/resend" method="POST" class="resend-verification-form">
            <label for="resend-email">Bestätigungs-E-Mail erneut senden</label>
            <input type="email" id="resend-email" name="email" autocomplete="email" required>
            <button type="submit">E-Mail erneut senden</button>
        </form>

        <p>Schon registriert? <a href="/login">Zum Anmelden</a></p>
    </div>
    <script src="/js/public/register.js" defer></script>
</body>
</html>
